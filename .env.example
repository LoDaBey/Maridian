# Postgres connection string.
# Locally: Render "External Database URL".
# On Render: "Internal Database URL".
DATABASE_URL=postgres://user:password@host:5432/dbname

# true for the external URL (local machine). false for the internal URL (on Render).
DATABASE_SSL=true

# At least 32 random characters. Used to sign the CSRF/socket token if needed.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public origin of this app.
APP_URL=http://localhost:3000

# development locally, production on Render.
NODE_ENV=development

# Shared secret for POST /api/cron/due-reminders
# CRON_SECRET=
